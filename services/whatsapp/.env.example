# Porta HTTP deste serviço (o app principal chama via WHATSAPP_SERVICE_URL).
PORT=4001

# URL pública do app Next.js — para onde os eventos de sessão/mensagem são
# enviados (POST assinado em /api/webhooks/whatsapp).
MAIN_APP_URL=http://localhost:3000

# Segredo HMAC compartilhado com o app principal — DEVE ser idêntico ao
# WHATSAPP_SERVICE_SECRET de apps/web/.env.local. Gere com: openssl rand -hex 32
WHATSAPP_SERVICE_SECRET=

# Diretório onde as sessões do whatsapp-web.js (LocalAuth) são persistidas,
# uma subpasta por tenant. Em produção, aponte para um caminho fora do
# diretório do código (sobrevive a deploys).
SESSIONS_PATH=./.wwebjs_auth
