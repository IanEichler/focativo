# =============================================================================
# Copie para apps/web/.env.local (desenvolvimento) ou para o ambiente do PM2
# (produção). NUNCA commite valores reais.
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Estoque IA"
# URL pública (usada em links de e-mail: confirmação, convite, recuperação)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Project Settings → API Keys) -----------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave publicável (sb_publishable_...) — pode ir ao navegador; o RLS protege os dados
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (sb_secret_...) — SOMENTE servidor. Ignora RLS.
SUPABASE_SECRET_KEY=

# --- Operação ----------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# Libera /design-system em produção (padrão: só em desenvolvimento)
ENABLE_DESIGN_SYSTEM_PAGE=false

# --- Somente desenvolvimento -------------------------------------------------
# Senha das contas fictícias criadas por `pnpm seed:dev`
SEED_DEV_PASSWORD=
