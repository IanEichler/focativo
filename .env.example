# =============================================================================
# Copie para apps/web/.env.local (desenvolvimento) ou para o ambiente do PM2
# (produção). NUNCA commite valores reais.
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Focativo"
# URL pública (usada em links de e-mail: confirmação, convite, recuperação)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Project Settings → API Keys) -----------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave publicável (sb_publishable_...) — pode ir ao navegador; o RLS protege os dados
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (sb_secret_...) — SOMENTE servidor. Ignora RLS.
SUPABASE_SECRET_KEY=

# --- Operação ----------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# Libera /design-system em produção (padrão: só em desenvolvimento)
ENABLE_DESIGN_SYSTEM_PAGE=false

# --- Pagamentos (Fase 5) -------------------------------------------------------
# Segredo HMAC que assina/valida webhooks em /api/webhooks/payments.
# Gere um valor forte por ambiente: openssl rand -hex 32
# Sem um gateway real configurado, o provider DEV usa este mesmo segredo para
# assinar a "confirmação simulada" — nunca é um mock de tela, o pipeline de
# webhook roda de verdade.
PAYMENT_WEBHOOK_SECRET=

# --- WhatsApp (Fase 6) ---------------------------------------------------------
# URL do serviço separado (services/whatsapp, processo PM2 próprio — nunca
# roda dentro do app Next.js). Deixe em branco em desenvolvimento: sem ela, a
# aplicação usa o provider DEV (simula QR/conexão/mensagens sem WhatsApp real).
WHATSAPP_SERVICE_URL=
# Segredo HMAC compartilhado com o serviço (assina chamadas nos dois sentidos:
# app → serviço para conectar/enviar, serviço → app no webhook de mensagens).
# Gere com: openssl rand -hex 32
WHATSAPP_SERVICE_SECRET=

# --- IA (Fase 7) -----------------------------------------------------------
# Chave da API da Anthropic. Vazio → provider DEV (regras por palavra-chave,
# sem custo, sem chamada real de LLM).
ANTHROPIC_API_KEY=
# Chave da API do Gemini (AI Studio) — provider alternativo, escolhido por
# tenant em tenant_ai_platform_limits.provider (admin master). Vazio → cai
# pro provider DEV do mesmo jeito que ANTHROPIC_API_KEY vazio.
GEMINI_API_KEY=

# --- Jobs (Fase 8) -----------------------------------------------------------
# Intervalo (minutos) entre varreduras do processo services/jobs — hoje só
# expira reservas vencidas em todos os tenants (reservations_expire_due_sweep).
# Este processo reusa NEXT_PUBLIC_SUPABASE_URL/SUPABASE_SECRET_KEY acima.
JOBS_INTERVAL_MINUTES=5

# --- Somente desenvolvimento -------------------------------------------------
# Senha das contas fictícias criadas por `pnpm seed:dev`
SEED_DEV_PASSWORD=
